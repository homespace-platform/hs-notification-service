PORT=8085
SERVICE_NAME=hs-notification-service

# Required. Supply your own MongoDB URI; no credentials belong in Git.
MONGODB_URI=

EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOSTNAME=localhost

# Must match hs-gateway-server/.env (min 32 chars); never commit the real value.
GATEWAY_INTERNAL_SECRET=

# Existing Docker broker exposed to host applications.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=hs-notification-service
KAFKA_GROUP_ID=hs-notification-service-v1
KAFKA_EVENTS_TOPIC=homespace.notification.events.v1
KAFKA_DLT_TOPIC=homespace.notification.events.dlt.v1
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_DELAY_MS=1000

# Optional channels: enable only after filling their configuration.
NOTIFICATION_REALTIME_ENABLED=false
USER_DIRECTORY_URL=http://localhost:8080/api/v1/admin/users
KEYCLOAK_ISSUER_URL=http://localhost:9000/realms/homespace-platform
# Fill the audience actually present in access tokens before enabling realtime.
KEYCLOAK_AUDIENCE=
NOTIFICATION_REALTIME_ORIGINS=http://localhost:3000

PUSH_ENABLED=false
# Full service-account JSON mapping. Runtime push currently uses project ID, email and private key.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
